{
  "name": "@gotcos/glasses-server",
  "version": "6.52.1",
  "description": "COS Glasses \u2014 self-hosted AI heads-up-display server for Even G2 smart glasses, powered by Claude Code, Codex, Cursor Agent CLI, or local Ollama",
  "type": "module",
  "bin": {
    "glasses-server": "bin/cli.cjs",
    "glasses-server-managed": "bin/managed-server.cjs",
    "glasses-memory-setup": "bin/memory-setup.cjs"
  },
  "scripts": {
    "start": "node bin/cli.cjs",
    "start:server": "node --import tsx/esm server/index.ts",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "mutation:gate": "node server/scripts/mutation-gate.mjs"
  },
  "keywords": [
    "even-g2",
    "smart-glasses",
    "claude-code",
    "codex",
    "ai",
    "cos",
    "heads-up-display",
    "whisper",
    "cursor"
  ],
  "files": [
    "bin/cli.cjs",
    "bin/managed-server.cjs",
    "bin/hooks/cos-session-hook",
    "managed-runtime-contract.json",
    "server",
    "!server/data/**",
    "!server/certs/**",
    "!server/models/**",
    "server/models/silero_vad.onnx",
    "shared",
    "!server/**/*.test.ts",
    "!server/scripts/engine-canary.ts",
    "!server/scripts/mutation-gate.mjs",
    "!server/lib/meeting-engine/__fixtures__/**",
    "!server/lib/__fixtures__/**",
    "!shared/**/*.test.ts",
    ".env.example",
    ".cos-profile.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "bin/memory-setup.cjs",
    "memory-runtime"
  ],
  "author": "COS Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukaoma/cos-glasses-server.git"
  },
  "homepage": "https://www.gotcos.com",
  "bugs": {
    "url": "https://github.com/ukaoma/cos-glasses-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsx": "^4.21.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.12.29"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
