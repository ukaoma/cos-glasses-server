{
  "name": "@gotcos/glasses-server",
  "version": "6.84.1",
  "description": "COS Glasses: self-hosted AI heads-up-display server for Even G2 smart glasses, powered by Claude Code, Codex, Cursor Agent CLI, or local Ollama",
  "type": "module",
  "bin": {
    "glasses-server": "bin/cli.cjs",
    "glasses-server-managed": "bin/managed-server.cjs",
    "glasses-memory-setup": "bin/memory-setup.cjs",
    "cos-control2-foundation": "bin/control2-foundation.cjs"
  },
  "scripts": {
    "start": "node bin/cli.cjs",
    "start:server": "node --import tsx/esm server/index.ts",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "mutation:gate": "node server/scripts/mutation-gate.mjs",
    "control2:lab": "node bin/control2-foundation.cjs"
  },
  "keywords": [
    "even-g2",
    "smart-glasses",
    "claude-code",
    "codex",
    "ai",
    "cos",
    "heads-up-display",
    "whisper",
    "cursor"
