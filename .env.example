# ── COS Glasses Server — configuration ──────────────────────────────────
# Lives at ~/.cos-glasses/.env (created on first run). Everything here is
# OPTIONAL — the server boots and chats with zero config as long as the
# Claude Code CLI is installed and logged in.

# ── PHONE ACCESS ────────────────────────────────────────────────────────
# The glasses app (on your iPhone) reaches this server over your network or
# mesh. The launcher sets 0.0.0.0 for you; set 127.0.0.1 to restrict to the
# local machine only. (The IP allowlist always blocks public internet traffic.)
BIND_HOST=0.0.0.0

# HTTP port the server listens on. HTTPS auto-enables on 3143 if you add
# cert.pem + key.pem under server/certs/ (optional; iOS WebView prefers HTTPS).
# PORT=3141

# ── AUTH ────────────────────────────────────────────────────────────────
# A token is required on every /api call EXCEPT six paths. Four are public because
# a client needs them BEFORE it holds a usable token; two are capability URLs
# because the browser API that fetches them cannot send a header at all:
#
#   GET  /api/health          server availability and capability advertisement
#   GET  /api/diag/health     recovery diagnostics
#   POST /api/diag/client     client-side crash/diagnostic upload
#   GET  /api/display-stream  the glasses display bus. EventSource cannot set
#                             headers, so this returns 200 to anyone — but a
#                             subscriber without a token gets a live transport and
#                             lifecycle markers ONLY, never transcripts or answers.
#   GET  /api/display-stream/<expiry>.<hmac>   short-lived capability URLs, each
#   GET  /api/tts/play/<uuid>                  minted by an AUTHENTICATED call, for
#                             EventSource and for native audio players respectively
#                             — neither can send a header. On the display stream the
#                             X-Cos-Token header is accepted as an equivalent, so any
#                             caller that CAN send one should; the TTS UUID also names
#                             which audio to play, so it is not interchangeable.
#
# Leave UNSET and the server prints an auto-generated token at boot — paste it into
# the phone app. Set a fixed value here for a stable token across restarts.
# COS_API_TOKEN=pick-any-long-random-string

# Optional durable image-store location. Defaults to
# ~/.cos-glasses/data/media alongside the standalone conversation/archive data.
# COS_MEDIA_ROOT=/path/on-a-local-volume/media

# Private canary for server 6.27.3 + companion 6.8.343. When enabled, every
# MP4/MOV uses a durable, resumable 256 KiB upload draft instead of one long
# WebView request. Accepted chunks and finalize receipts survive server
# restarts. Leave off for the released transport; COS Control 0.5.20 manages
# this setting and prevents unsafe binary rollback while V2 state exists.
# COS_VIDEO_UPLOAD_V2=0

# Optional logical server identity location. Most installs should keep the
# default (~/.cos-glasses/server-instance-id) so reconnects can verify the same
# server after Wi-Fi/Tailscale changes and process restarts.
# COS_SERVER_INSTANCE_ID_PATH=/path/to/server-instance-id

# 6.89.0 Tailscale self-heal. After a restart, a wake from sleep, a Tailscale
# restart or a network change, or when a recently active phone goes quiet while
# Tailscale says it is online, the server runs a bounded `tailscale ping` at it
# (at most one a minute per phone, 30 an hour). On by default; 0 turns it off.
# See docs/tailscale-self-heal.md.
# COS_TAILSCALE_NUDGE=0

# 6.90.0 Mac recording voice labels. After a Mac recording is saved, one Nemotron
# pass over the whole meeting labels its voices Voice 1, Voice 2, ... (unnamed,
# stable for the meeting). No voice profile is read or written, and renaming a
# Voice N is text only. Crowded or unclear rooms stay Ext. On by default; 0 turns
# it off (and both live modes below) and Mac recordings stay all Ext.
# COS_MAC_VOICE_LABELS=0

# 6.92.1 / 6.93.0 live Mac voices, ON by default as the window replay. COS_MAC_LIVE_VOICES=off
# (also 0, false, no) makes every live Mac chunk read Ext, exactly as 6.92.0 (the after-save
# pass above still numbers the voices). One switch, three values:
#   off      the opt-out: 6.92.0.
#   anchors  opt-in, the 6.92.1 per-chunk path: a chunk reads Voice N after two clean, agreeing
#            observations. On natural audio it rarely fires.
#   window   the default (6.93.0): each live chunk is diarized inside the last five durable
#            chunks (30 s), so a voice keeps its number across 6 s boundaries. A carried
#            voice is used only when the chunk diarized alone agrees (one extra short run).
#            That catches a merge of two voices speaking in the same chunk; it does not yet
#            catch a clean hand-over to a new voice at a chunk boundary: that speaker can
#            read the previous number (a wrong number, never a wrong name).
#            Window runs get a timeout sized from their length and fall back to the
#            per-chunk run on a timeout; two timeouts in a row stop the window for that capture. Unlabeled speech stays Speaker.
# No names, no enrollment, no training on their own. COS_MAC_VOICE_LABELS=0 turns both off. Restart the server
# after changing it; GET /api/health shows capabilities.macLiveVoices.mode.
# COS_MAC_LIVE_VOICES=off

# 6.93.0 iPhone microphone meetings, OFF by default. 1 lets the server accept a meeting
# recorded from the iPhone microphone (COS Glasses 6.10.655 and COS Control 0.5.351 or
# newer). It also needs the HQ engine set to Parakeet Ultra with Parakeet installed;
# GET /api/health then reports capabilities.phoneMicrophoneMeetings.enabled true.
# Phone meetings are anonymous (every line is Ext) and never train a voice profile.
# Not iOS system audio: it cannot record Zoom, YouTube or calls playing on the phone.
# COS_IPHONE_MICROPHONE_MEETINGS=1

# 6.91.0 dictation polish. Prompt v4 is the default on Sonnet (Haiku and Luna keep
# v3): self-corrections first ("two, actually three" keeps three), restarts, grammar
# in your own words, no added em dashes. 3 (or COS_DICTATION_POLISH_PROMPT=v3) puts
# every model on the 6.90.0 prompt byte for byte; 4 puts every model on v4.
# COS_DICTATION_PROMPT_VERSION=3
# The literal register is opt-in, because terminal targets are mostly AI prompts in
# prose. 1 gives terminals (iTerm2, Terminal, Ghostty, Warp, WezTerm, Alacritty, kitty)
# your words only: no resolved corrections, grammar fixes, added capital or period.
# COS_DICTATION_REGISTERS=1
# Your style: rules COS Control learns from your edits, stored in
# <data>/dictation-learned-style.json and used for Mac dictation and G2 messages on
# Sonnet with v4, terminals included, never meeting lines (and never a terminal when
# COS_DICTATION_REGISTERS=1 makes it literal). On by default; 0 stops it applying
# everywhere (the capability then says enabled false; the rules are kept).
# COS_DICTATION_LEARNED_STYLE=0
# The meaning guard runs only on Sonnet with v4 (never on Haiku, Luna, other models,
# prompt v3 or meeting lines): it refuses a polish that lost a negation, number,
# weekday or month, or name you said (or added a negation or number), and pastes the
# unpolished text. 0 turns it off.
# COS_DICTATION_MEANING_GUARD=0
# Daily polish budgets, one per caller (local day): Mac dictation and G2 messages
# (default 300; the older shared variable is its fallback), G2 meeting lines (200),
# prompt drafts (200).
# COS_DICTATION_AUTOCLEAN_MAX_PER_DAY=300
# COS_DICTATION_AUTOCLEAN_MAX_PER_DAY_MESSAGE=300
# COS_DICTATION_AUTOCLEAN_MAX_PER_DAY_MEETING=200
# COS_DICTATION_AUTOCLEAN_MAX_PER_DAY_PROMPT_DRAFT=200
# The polish prompt for every model (v1 to v4); the alias above takes 3 or v3.
# COS_DICTATION_POLISH_PROMPT=v3
# The deterministic um/uh pass before the model (English text only since 6.92.0;
# never meeting lines). On by default; 0 sends the text to the model as heard.
# COS_DICTATION_FILLER_PASS=0
# "forward slash pricing" written "/pricing" before the model. On by default.
# COS_DICTATION_SPOKEN_PATHS=0
# Start the polish process at key press (Claude models). On by default.
# COS_DICTATION_PREWARM=0
# Skip the model when the text has nothing for it to fix. Off by default.
# COS_DICTATION_POLISH_SKIP_CLEAN=1
# 6.92.0: the polish breakers are keyed by model and caller group (Mac dictation, G2
# messages and prompt drafts; meeting lines on their own). A client that stops waiting
# never counts as a failure; this many such aborts in a row, each after 4 s or more of
# model time, pause that model's polish for _MS (default 4 and 300000, 5 minutes).
# COS_DICTATION_SLOW_BREAKER_ABORTS=4
# COS_DICTATION_SLOW_BREAKER_MS=300000
# 6.92.0: G2's prompt edit. On by default; 0 answers 503 "Edit is off". At most
# _DAILY_CAP edits a local day (default 200, its own counter), then 429 "Edit limit
# reached"; 3 failures in a row pause it 10 minutes (503 "Edit paused"). The model,
# effort and timeout default to sonnet, low and 45000 ms.
# COS_PROMPT_EDIT=0
# COS_PROMPT_EDIT_DAILY_CAP=200
# COS_PROMPT_EDIT_MODEL=sonnet
# COS_PROMPT_EDIT_EFFORT=low
# COS_PROMPT_EDIT_TIMEOUT_MS=45000

# Build 204+ uses server-owned durable query jobs by default. The server fsyncs an
# accepted prompt before returning 202, then keeps provider work running if the
# phone backgrounds, reloads, or changes networks. Reopening COS reattaches to
# the same job. Set to 0 to send NEW prompts through the legacy
# streaming route; already accepted durable jobs remain readable/cancellable
# and drain safely.
# COS_DURABLE_QUERY_JOBS=0

# 6.78.0: crash-loop parking. Work the server resumes on boot (meeting finalization, a
# question that never started) is parked after it was resumed on 3 boots in a row that each
# followed a crash less than 30 minutes after the last, instead of restarting the server
# forever. Update Server and other clean restarts never count, and a clean exit starts the
# count over. Parked work stays saved and is listed under `parked` in
# GET /api/maintenance/status (the count is on /api/health). Retry it with
# POST /api/maintenance/parked/<kind>/<id>/retry with the API token (the phone and the lens
# can, not only this Mac), or Retry the question in the app. A parked meeting finalization
# also gets one automatic second chance on the first boot 30 minutes after it was parked.
# On by default; 0 / false / off turns it off (6.77.0 behaviour).
# COS_CRASH_LOOP_PARKING=0

# 6.78.0: restart truth. A question a restart cut off (a crash, or a graceful stop such as
# Update Server or a Mac restart) ends "Server restarted. Tap to retry." and its job record
# names the step it was cut off during and the steps that had already changed something
# (edits, commands), so you can choose Resume or Retry knowing what already happened. On by
# default; 0 / false / off turns it off (the 6.77.0 messages, and no `interruption` record).
# COS_RESTART_NOTICE=0

# 6.78.0: the compact question journal. Off by default in this release: this release only
# READS compact rows, so a rollback to it from the next one keeps every answer. 1 / true / on
# stores each streamed piece once instead of the whole answer so far (much smaller journals).
# Leave it off until the release after 6.78.0 turns it on.
# COS_QUERY_JOB_DELTA_JOURNAL=1

# 6.78.0: steer a running answer from the glasses (Claude only). Off by default in 6.78.0.
# 1 / true / on lets COS Glasses 6.10.645 or later add guidance to an Ask while Claude is still
# working on it: the guidance joins the running answer at its next step. Codex, Cursor and
# Ollama answers are never steered; the app sends the guidance as the next Ask instead.
# Needs a Claude Code CLI that lists --input-format and --replay-user-messages.
# COS_MESSAGES_STEER=1

# 6.52.0: the Messages trail (readable steps of a running Messages job, journaled and sent
# only to a client that asks with ?trail=1). On by default. 0 is the rollback that needs no
# downgrade: no trail is recorded and every job stream and snapshot is the 6.51.0 one.
# COS_MESSAGES_TRAIL=0

# 6.52.0: session questions and tool approvals answered from the glasses or the phone
# while you are away from the Mac. Nothing is ever held unless a client polls
# GET /api/session-questions?client=glasses|phone (COS Glasses 6.9.511 and earlier do not).
#   0 / false / off  every permission request gets the Mac's own dialog (no reinstall)
#   questions        hold AskUserQuestion cards, never tool approvals
#   unset / other    hold both
# Keep these here, not only in the LaunchAgent plist: this file survives Update Server.
# COS_PERMISSION_BROKER=questions
# 6.71.7: after Reinstall hooks, stamped interactive questions can wait at the desk
# while their native dialog stays available. Their card appears at the idle threshold
# and remains until answer/cancel/expiry. Approvals and old hooks keep the prior rules.
# Per-hook rollback without reinstall: echo 0 > ~/.cos-glasses/hook-ask-hold
# COS_PERMISSION_BROKER_DESK_IDLE_S=90     # never below 30
# COS_PERMISSION_BROKER_TIMEOUT_S=110      # clamped to 5..120 (under the hook's 125 s)

# ── THE LLM (chat) ──────────────────────────────────────────────────────
# Chat runs through your LOCAL agent CLI — NOT an API key:
#   Opus / Fable / Sonnet  ->  Claude Code CLI  (https://docs.anthropic.com/en/docs/claude-code/getting-started, then `claude auth login`)
#   GPT Frontier/Balanced  ->  Codex CLI        (https://developers.openai.com/codex/, then `codex login`)
# Install at least one. Pick the default model the glasses use:
# COS_G2_DEFAULT_MODEL=sonnet     # opus | fable | sonnet | codex-frontier | codex-balanced | cursor-grok | cursor-composer | ollama
#
# GPT slots refresh from the Codex model catalog every 15 minutes and retain
# their last-known-good resolution if discovery is temporarily unavailable.
# COS_CODEX_MODEL_REFRESH_TTL_MS=900000
# COS_CODEX_MODEL_REFRESH_TIMEOUT_MS=7000
#
# Legacy explicit overrides remain supported for migrated codex-high/frontier
# installs. Leave blank for auto-latest; Balanced always stays auto-catalog.
# COS_CODEX_MODEL=
# COS_CODEX_REASONING_EFFORT=high   # low | medium | high | xhigh | max | ultra
#
# Codex remains read-only by default. Broader trust opt-in (workdir writes +
# outbound network inside that sandbox — needed for Gmail API / HTTPS):
# COS_CODEX_SANDBOX=workspace-write
# Pair with ~/.codex/config.toml [sandbox_workspace_write] network_access = true
# for interactive Codex CLI; the managed glasses server also passes
# -c sandbox_workspace_write.network_access=true when workspace-write is set.
#
# Local Ollama (https://ollama.com) as a fourth G2 picker. Hidden unless
# GET http://127.0.0.1:11434/api/tags succeeds with at least one pulled model.
# Ollama runs read-only COS tools when the pulled tag advertises tools and COS_SCRIPTS_DIR is set; no vision, no Codex --oss.
#   brew install ollama
#   ollama serve
#   ollama run qwen2.5-coder
# COS_OLLAMA_MODEL=qwen2.5-coder
# COS_OLLAMA_HOST=http://127.0.0.1:11434
# COS_G2_DEFAULT_MODEL=ollama
#
# Codex CLI operator hatch (not the Ollama picker). Frontier stays ChatGPT
# unless you set this. Put it in ~/.cos-glasses/.env, not the LaunchAgent plist.
# Sessions Continue / Fork ignore these flags. No inline comments on this line.
# COS_CODEX_EXTRA_ARGS=--oss --local-provider ollama --model qwen2.5-coder
# Do not define [model_providers.ollama] — that id is reserved. LM Studio:
# COS_CODEX_EXTRA_ARGS=--oss --local-provider lmstudio --model <id>
# Other OpenAI-compatible proxies (not oss): --model inside EXTRA_ARGS so a
# plist COS_CODEX_MODEL cannot retarget it:
# COS_CODEX_EXTRA_ARGS=-c model_provider="local_vllm" --model <id>

# Claude preserves COS's established trusted-machine behavior by default.
# Security-conscious installs can remove the permission bypass and restrict
# Claude to COS's explicit per-query tool allowlist. Undeclared tools fail
# closed without an interactive prompt:
# COS_CLAUDE_TRUST_MODE=allowlist
# Optional comma-separated MCP tool selectors made available to BOTH full and
# lightweight glasses queries. Only mcp__server__tool / mcp__server__* entries
# are accepted; built-in Bash/Write access cannot be enabled here.
# COS_EXTRA_TOOLS=mcp__calendar__*,mcp__gmail__search
# Optional absolute MCP config when the managed CLI cwd does not contain it.
# COS_CLAUDE_MCP_CONFIG=/absolute/path/to/.mcp.json

# ── VOICE (optional) ────────────────────────────────────────────────────
# Local transcription is FREE via whisper.cpp (brew install whisper-cpp; the
# real-time turbo model auto-downloads on first run). Full HQ dictation also
# needs ggml-large-v3.bin as documented in README. Voice is local-only by default. Merely
# configuring a key never uploads audio. To allow OpenAI Whisper only after a
# local failure, set BOTH the exact opt-in and a key:
# COS_OPENAI_WHISPER_FALLBACK=1
# OPENAI_API_KEY=sk-...
# COS_HQ_SPECULATIVE_WARM=0        # disable background HQ warm
# COS_BATCH_LARGE_V3=0             # explicitly use turbo instead of full HQ
# COS_HQ_BEAM_INTERACTIVE=2        # interactive only; meetings stay at beam 5
# Control owns the machine-wide tier. Balanced is recommended: Small.en is a
# cosmetic prompt preview only, while Turbo commits authoritative live text and
# Large-v3 polishes saved work. Max reuses the resident Large-v3 worker for
# preview + commit; it is opt-in for powerful Macs and never starts a third
# Whisper worker.
# COS_WHISPER_TRANSCRIPTION_TIER=balanced   # balanced | max
# COS_WHISPER_COMMIT_MODEL=turbo            # turbo | large-v3 (advanced override)
# Adaptive prompt transcription keeps three quality lanes separate:
#   Small.en provisional preview -> Large-v3-Turbo committed live text -> Large-v3 HQ polish.
# Unset preserves the pre-6.20 Turbo behavior. `auto` uses Small.en when it has
# been provisioned, otherwise Turbo. Guided Setup writes small.en explicitly
# and downloads its ~466 MB model. `off` hides provisional peeks without
# changing committed transcription or meeting audio.
# COS_WHISPER_PREVIEW_MODEL=auto    # auto | small.en | turbo | off

# Who spoke when (6.61.0). Nemotron 3 Diarization separates the voices in each
# chunk and at save; the voiceprint names them. It needs FluidAudio's
# fluidaudiocli and its models ON THIS MAC: the server always passes --models
# and never lets the CLI download. Missing either, labels stay on the voiceprint.
# COS_DIARIZER=nemotron            # nemotron | embedding (voiceprint only, the 6.60 labels)
# COS_NEMOTRON_CLI=~/.cos-glasses/bin/fluidaudiocli
# COS_NEMOTRON_MODELS=~/.cos-glasses/models/nemotron-3-diarization   # holds Nemotron3Diarizer_fast32.mlmodelc + learnable_sil_emb.bin

# Spoken reply playback defaults to local Kokoro on Apple silicon Macs. The
# first run creates a private venv and downloads the model. Local mode fails
# closed: it never sends text to OpenAI. Set openai_primary only when cloud TTS
# is desired and OPENAI_API_KEY is configured.
# COS_TTS_ENGINE=local_first       # local_first | openai_primary
# COS_TTS_LOCAL_PORT=8179
# COS_TTS_LOCAL_TIMEOUT_MS=12000
# COS_TTS_KOKORO_VOICE=am_echo
# COS_TTS_LOCAL_DISABLE=1          # disable the local sidecar explicitly
# COS_TTS_PRONUNCIATIONS_JSON={"Exampleco":{"local":"[Exampleco](/ɪgzˈæmpəlkoʊ/)","openai":"ig-ZAM-pul-co"}}

# ── WELCOME WEATHER (optional) ──────────────────────────────────────────
# Phone GPS (Even Hub location permission) is the primary source. The Mac only
# proxies Open-Meteo via GET /api/welcome-context?lat=&lon= (auth required).
# Prove: curl -H "x-cos-token: $COS_API_TOKEN" \
#   "http://127.0.0.1:3141/api/welcome-context?lat=30.27&lon=-97.74"
# If the phone denies location, set a home fallback (omit weather otherwise):
# COS_WEATHER_DEFAULT_LAT=30.5788
# COS_WEATHER_DEFAULT_LON=-97.8531
# COS_WEATHER_DEFAULT_CITY=Home

# ── FULL COS PIPELINE (optional — leave unset for standalone) ────────────
# Power users running the COS Starter Kit can point the glasses at their
# pipeline to inherit live tasks/calendar/people context. Omit for standalone.
# COS_SCRIPTS_DIR=/path/to/your/cos/operations/scripts
#
# G2 "Review Meetings" accepts either layout:
#   {COS_MEETINGS_ROOT}/YYYY-MM/*.md                      # one read-only library
#   {COS_OPERATIONS_DIR}/{domain}/meetings/YYYY-MM/*.md  # multi-domain pipeline
# Keep COS_OPERATIONS_DIR for enrichment and writes. COS_MEETINGS_ROOT is a
# browse override; legacy values that contain a multi-domain operations tree
# retain their old alias behavior. If both are unset, the server tries
# COS_SCRIPTS_DIR/.. and then local G2 recordings.
# COS_OPERATIONS_DIR=/path/to/your/cos/operations
# COS_MEETINGS_ROOT=/path/to/your/existing/meetings

# Telegram session/activity notifications remain OFF even if the COS scripts
# directory contains .telegram_config.json. Enable export explicitly:
# COS_TELEGRAM_NOTIFICATIONS=1

# ── POST-MEETING HQ TRANSCRIPTION DEVICE (optional) ──────────────────────
# After a meeting saves, the server re-transcribes it with whisper-cli
# large-v3 ("polish"). Since 6.14.1 that batch has run on CPU (-ng) so it can
# never fight a live meeting's ASR for the GPU — going meeting-to-meeting, the
# polish of meeting A overlaps the live capture of meeting B, and two Metal
# workloads degrade each other. The tax is that idle polish is slow too.
#
# COS_BATCH_HQ_METAL=1 opts into GPU-when-idle: each segment picks Metal only
# when nothing live is contending, and a meeting starting mid-batch preempts
# the GPU immediately (the interrupted segment is discarded and retried on CPU
# — a truncated transcript is never saved). Default is OFF; leave it unset
# until you have run a meeting-to-meeting smoke on your own machine.
# COS_BATCH_HQ_METAL=1
#
# COS_BATCH_HQ_FORCE_CPU=1 is the blunt rollback. It wins over everything and
# keeps working if the default ever flips to Metal-on.
# COS_BATCH_HQ_FORCE_CPU=1

# Private 6.21.8 canaries can precompute reusable Large-v3 checkpoints for
# sealed 30-second windows while a meeting is still running. Work is CPU-only,
# global-single-flight, preemptible, and never canonical until Stop/save accepts
# it. Balanced is hard-capped at 2 threads for fanless M1/M2 MacBook Airs; Max
# defaults to 6 and is still capped by available CPUs. Leave OFF for public use
# until the canary latency/thermal gate passes.
# COS_MEETING_PROGRESSIVE_HQ=1
# COS_MEETING_PROGRESSIVE_HQ_THREADS=2   # optional lower override; cannot raise the tier cap

# HQ timing and Meeting Ask evidence. Since 6.72.0 HQ timestamps follow the HQ
# setting (on for "large-v3"); COS_BATCH_HQ_TIMESTAMPS is an override (see the
# Speech-to-text section below). Meeting Ask HQ evidence stays default OFF and
# additionally needs COS_BATCH_HQ_TIMESTAMPS=1 and progressive HQ: it FAILED the
# 30-second live refinement gate on the test machine. Do not enable for public use.
# COS_MEETING_ASK_HQ_EVIDENCE=1

# Meeting-wide Fact check (6.71.13). Default ON: the first Fact check in a
# meeting checks every checkable public claim, later ones only new content, and
# follow-ups continue the pending check. Set to 0 for the 6.71.12 latest-claim
# path. Public-topic consent in Meeting assistant settings is still required.
# COS_MEETING_FACT_CHECK_SCOPE=0
#
# A medication-dose question for a specific person gets fixed safety
# information, with no model call and no web search. Default ON; 0 turns it off.
# COS_MEETING_ASK_DOSE_GUARD=0

# Early Sync writes stable meeting identity to the Operations pipeline before
# HQ finishes, then enriches that same artifact in place. It is I/O-only and
# deliberately independent from the progressive-HQ compute switch.
# COS_MEETING_EARLY_SYNC=1

# ── Standalone meeting summaries ──────────────────────────────────────────────
# Generate summary / topics / decisions / action items for meetings recorded
# WITHOUT the COS operations pipeline (no COS_SCRIPTS_DIR). Spawns one
# `claude -p --model haiku` per meeting, at the end of finalization.
#
# Default ON since 6.37.0. Set to 0 to opt out; only a literal 0 disables.
# With it off you still get the deterministic tier — speakers, talk-time, word
# count, opening excerpt — which costs nothing and always runs.
#
# This spends tokens on YOUR provider plan, unlike the display toggles. It is
# bounded by a per-day cap (below) counted only on a validated summary, a
# circuit breaker, a minimum word floor, a single-slot queue and a wall budget.
#
# Never runs when COS_SCRIPTS_DIR is set: overwriting the summary section would
# erase the markers sync_meetings.py uses to decide what to process.
# COS_MEETING_SUMMARY=0
#
# Calls per local day before the summariser falls back to the deterministic
# tier for the rest of the day. Default 40.
# COS_MEETING_SUMMARY_DAILY_CAP=40

# ── LENS GIST: the summary behind the G2 prompt box (6.54.0) ────────────
# Outcome / So what / You asked for a finished session or message, written by the
# engine you pick: claude (default, when the Claude CLI is installed), codex, cursor,
# ollama, or off. A mistyped engine is off. PUT /api/lens-gist/config saves the same
# choice in the data dir; this setting wins over it.
# COS_LENS_GIST_ENGINE=claude
# COS_LENS_GIST_MODEL=sonnet
#
# Or a chain, asked in order when one fails, cools down or reports a usage limit.
# Each engine in it sees the reply. COS_LENS_GIST_MODEL does not apply to a chain.
# COS_LENS_GIST_ENGINE=claude:sonnet,codex:gpt-5.6-terra
#
# Answers per local day (attempts stop at twice this). Default 150.
# COS_LENS_GIST_DAILY_CAP=150


# ── RETAINED MEETING-AUDIO PLAYBACK CLEANUP (6.21.32 canary) ────────────
# Default OFF. When enabled, the first authenticated Play of a retained raw
# meeting chunk creates a cached, adaptive cleanup copy. Raw WAV evidence stays
# byte-identical; capture, live preview, canonical transcription, HQ, and sync
# are untouched. Any FFmpeg/analyzer failure serves raw. Use `?raw=1` on the
# playback URL for a per-request A/B comparison.
# COS_MEETING_AUDIO_ADAPTIVE_PLAYBACK=1

# ── UNSAVED-CAPTURE QUARANTINE (6.19.0) ─────────────────────────────────
# Meeting audio whose save never landed is QUARANTINED, never deleted. It
# surfaces on /api/health (unsaved_captures) and, with COS Control 0.3.1+,
# as an "Unsaved captures" row in the status card. One authenticated call
# recovers a capture into a durable meeting scribe:
#   curl -X POST -H "x-cos-token: $COS_API_TOKEN" \
#     http://127.0.0.1:3141/api/meeting/orphans/<sessionId>/recover
# Quarantined audio expires on this retention clock (hours, clamped 1-720).
# 72 covers a long weekend away from the Mac.
# COS_UNSAVED_AUDIO_RETENTION_HOURS=72

# ── LIVE CUES (optional, OFF unless you set it — costs model calls) ───────
#
# The closest thing COS has to conversing with you DURING a meeting rather than
# after it: it reads the running transcript and puts short prompts on the lens —
# the question you would have wanted to ask, while it is still useful.
#
# WHAT IT COSTS, PLAINLY. Every cue is a model call on YOUR agent quota, not a
# free local pass. It is bounded, but it is not free:
#
#     at most 8 cue pipelines per meeting     MAX_PIPELINES_PER_MEETING
#     at most one start per 60 seconds        FLOOR_BETWEEN_STARTS_MS
#     30s cooldown after a cue fires          COOLDOWN_AFTER_CUE_MS
#
# So a long meeting can spend up to 8 model calls it would not otherwise make,
# and each one runs the full planner -> memory -> insight chain below. On a
# metered plan, leave this off. It IS off unless you set it.
#
# Runs on Cursor Composer. That is the only supported model in v1 — any other
# value fails closed rather than quietly billing a model you did not choose.
#
# Live meeting coaching cues on the lens: transcript window -> Composer
# planner -> Qdrant -> LightRAG -> Composer insight -> coaching_nudge.
# Requires COS_SCRIPTS_DIR (memory hops) plus the Cursor Agent CLI.
# Set these in ~/.cos-glasses/.env — NOT the LaunchAgent plist: COS Control
# refuses unknown env keys and rebuilds plist env from its manifest, so a
# hand-edited plist value is dropped by the next Update Server.
# COS_LIVE_CUES=1                      # master switch (kill switch: set 0 + restart)
# COS_LIVE_CUES_MODEL=cursor-composer  # only supported value; others fail closed
# COS_LIVE_CUES_LIGHTRAG_RESERVE=120   # leave >=N of the shared 200/day query pool
# COS_LIVE_CUES_AUTO=0                 # debug only: arm without the phone toggle
#
# COS_LIVE_CUES_GRAPH=1 — LightRAG entity hop. OFF by default; measure before
# enabling. On a 31k-entity / 66k-relationship graph we measured p50 73.5s and
# max 117s across 5 real explores, so only 1 in 5 finished inside the 40s hop
# budget. The rest would spend 40s of the 60s pipeline wall AND two calls from
# the shared 200/day query pool only to end up degraded. Time your own graph:
#   time <scripts>/venv/bin/python3 <scripts>/lightrag_search.py --explore "Some Entity"
# Consistently under ~30s, turn it on. Otherwise leave it off — cues still get
# memory grounding from Qdrant, which returns in ~1.5s.

# Sessions Continue: 0 restores the 6.61 posture (Codex configured sandbox,
# Cursor Ask). Default 1 preserves session settings; Cursor Run Everything
# additionally requires a client that acknowledges displaying continue_note.
# Keep this in ~/.cos-glasses/.env; Control does not yet persist it on update.
COS_CONTINUE_FULL_PERMISSIONS=1

# Optional absolute executable paths for COS-managed whisper.cpp.
# Unset uses Homebrew then PATH. An invalid explicit path fails closed.
# COS_WHISPER_CLI_BIN=/absolute/path/to/whisper-cli
# COS_WHISPER_SERVER_BIN=/absolute/path/to/whisper-server

# ── Speech-to-text settings (6.72.0) ────────────────────────────────────────
# The engines, front end and quiet gate are chosen in <data>/stt-settings.json
# through GET/PUT /api/stt-settings (COS Control 0.5.289, COS Glasses 6.10.639).
# These variables only move files or force a mode.
# COS_BATCH_HQ_TIMESTAMPS=1          # 1 forces HQ timestamps on, 0 forces the legacy decoder, unset follows the HQ setting
# COS_PARAKEET_DIR=~/.cos-glasses/data/stt/parakeet          # where Parakeet installs (CLI copy, models, CoreML cache)
# COS_PARAKEET_LOCAL_SOURCES=/path/a:/path/b                 # folders holding verified model copies to install from (hash-checked)
# Drop-in alternative: link a folder holding parakeet-ultra/ to
# <data>/stt/parakeet-sources and an install started with {} uses it, no download.


# ── Sessions: restart safety, Send again and steer (6.78.0) ─────────────────
# Read per request, like every 6.78.0 switch: 1 / true / on is on, 0 / false / off is off,
# anything else the default.
# COS_QUEUE_RECONCILE=1   # attempt journal, restart reconcile, receipts, reason copy (default on)
# COS_PIN_BOOT_REAP=1     # free a thread a crashed run held, 31 min after the restart and once its child is gone (default on; 0 = the 24 h reap)
# COS_QUEUE_RESEND=1      # Send again on a refused or expired queued turn (default on)
# COS_SESSION_STEER=0     # steer a busy Claude session through its peer inbox (default off)


# ── Answer with your own key (6.80.0, opt in) ──────────────────────────────────
# Off by default. With this unset, nothing about key lanes runs until COS Control turns them on
# from its Settings row (that writes data/key-lanes.json). 1 turns them on from the environment;
# 0 forces them off and wins over Control. Keys are saved only through COS Control on this Mac,
# in data/key-secrets/ (0700). Your key is saved on this Mac: apps and agents that run on this
# Mac as you can read it, so your provider's own spending limit is the real stop.
# COS_KEY_LANES=0
