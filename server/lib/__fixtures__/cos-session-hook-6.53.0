#!/bin/sh
# COS session hook (glasses-server 6.48.0; Cursor Stop follow-up 6.51.0; halt check 6.53.0). Installed into ~/.claude/settings.json by
# `--hooks install`; Claude Code runs it with the hook event name as $1 and the event
# payload on stdin. It spools one JSON file per event into the hook spool and exits 0
# on every path. Only PermissionRequest ever talks to the server, and only when the
# desk has been idle. Everything else is a file write, so the server being down or
# restarting never delays a Claude session.
#
# 6.53.0: PreToolUse is SYNCHRONOUS with no matcher, so the first branch below runs before
# EVERY tool call in every Claude session on this Mac. It is file-only (no curl, no spool
# write) and prints nothing unless the server left a halt marker for this session, when it
# prints the one reply that stops the run (canary C1b, 2026-09-21: `continue:false` alone
# still ran the tool; with the deny it did not). It never exits 2: exit 2 blocks the tool,
# while a timeout or any other code fails open (C6, C7).
#
# The installer bakes COS_GLASSES_HOME and COS_HOOK_SPOOL into the command, so this
# script and the server can never disagree about where the token or the spool is.
PATH=/usr/bin:/bin:/usr/sbin; umask 077; trap '' PIPE
HOME=${HOME:-$(cd ~ 2>/dev/null && pwd)}; [ -n "$HOME" ] || exit 0
GH=${COS_GLASSES_HOME:-$HOME/.cos-glasses}
SPOOL=${COS_HOOK_SPOOL:-$GH/data/hook-spool}; EVENT="$1"
# 6.53.0, the halt check. FIRST, before mkdir, perl and the B8 guard below: a full spool or
# a stale drain stamp must never stop a cancel, and an ordinary tool call must cost nothing
# but this. The marker folder sits beside the spool, like the Cursor queue folder; the server
# writes `<folder>/<session id>` (lib/session-halt.ts). stdin is read ONCE, to a temp file,
# and handed to the spool path below when the event still needs spooling.
IN=''
case "$EVENT" in PreToolUse|UserPromptSubmit)
  IN=$(mktemp "${TMPDIR:-/tmp}/cos-hook.XXXXXX" 2>/dev/null || mktemp /tmp/cos-hook.XXXXXX 2>/dev/null) || IN=''
  # No temp file: a tool call goes ahead unchecked (fail open), and a prompt is spooled
  # below exactly as before, its stdin untouched.
  [ -n "$IN" ] || [ "$EVENT" = UserPromptSubmit ] || exit 0
  ;;
esac
[ -z "$IN" ] || {
  HALT="$(dirname "$SPOOL")/session-halt"
  trap 'rm -f "$IN"; exit 0' HUP INT TERM
  head -c 1048576 > "$IN" 2>/dev/null
  # Any marker at all? A glob is a builtin, so the common case (no cancel anywhere on the
  # Mac) reads no session id and forks nothing for it.
  SID=''; for F in "$HALT"/*; do [ -e "$F" ] && SID=x; break; done
  # The FIRST session_id is the payload's own: Claude writes it first, and a tool's input
  # that happens to carry one comes later.
  [ -z "$SID" ] || SID=$(grep -Eo '"session_id"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f-]{36}"' "$IN" 2>/dev/null | head -1 | grep -Eo '[0-9A-Fa-f-]{36}' | tr 'A-F' 'a-f')
  if [ "$EVENT" = UserPromptSubmit ]; then
    # A new prompt is never stopped: the marker lives only within the run it was written
    # for. This covers a prompt typed at the desk, a Continue delivered into the open
    # session, and a COS `-p` turn. Then the prompt is spooled exactly as before.
    [ -z "$SID" ] || rm -f "$HALT/$SID" 2>/dev/null
  elif [ -n "$SID" ] && [ -f "$HALT/$SID" ]; then
    rm -f "$IN"
    printf '%s' '{"continue":false,"stopReason":"Cancelled from COS","hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Cancelled from COS"}}'
    exit 0
  else
    # Only the two tools the reducer reads were ever spooled (the 6.48 matcher); every
    # other tool call ends here with nothing written and nothing printed.
    TOOL=$(grep -Eo '"tool_name"[[:space:]]*:[[:space:]]*"[A-Za-z]+"' "$IN" 2>/dev/null | head -1)
    case "$TOOL" in *'"AskUserQuestion"'|*'"ExitPlanMode"') ;; *) rm -f "$IN"; exit 0 ;; esac
  fi
  # The spool path below reads stdin: hand it the saved bytes. The open descriptor keeps
  # them readable after the unlink, so no temp file outlives this line.
  exec < "$IN"; rm -f "$IN"; trap - HUP INT TERM
}
mkdir -p "$SPOOL/rejected" 2>/dev/null || exit 0
TS=$(perl -MTime::HiRes -e 'printf "%.0f", Time::HiRes::time()*1000' 2>/dev/null || date +%s000)
# B8 guard: a full spool or a stale drain stamp means nobody is reading; keep only permissions.
if [ "$EVENT" != PermissionRequest ]; then
  N=$(ls "$SPOOL" 2>/dev/null | wc -l | tr -d ' '); [ "${N:-0}" -lt 2000 ] || exit 0
  STAMP="$SPOOL/.last-drain"; [ ! -f "$STAMP" ] || [ -z "$(find "$STAMP" -mmin +1440 2>/dev/null)" ] || exit 0   # -mtime +1 would mean two days
fi
T="$SPOOL/.tmp.$$.$TS"; head -c 1048576 > "$T.in"                    # stdin to disk, 1 MiB cap
case "$(head -c 1 "$T.in")" in '{') ;; *) EVENT=rejected ;; esac
{ printf '{"ts":%s,"ppid":%s,"event":"%s","payload":' "$TS" "$PPID" "$EVENT"; cat "$T.in"; printf '}\n'; } > "$T"
rm -f "$T.in"
# 6.51.0, CURSOR ONLY. Cursor runs this hook from ~/.claude/settings.json for its own
# composers, and submits a Stop hook's {"followup_message":...} as that composer's next
# message. A turn COS queued for the composer is handed over here, at the end of its turn.
# Claude Code sets no CURSOR_VERSION and sends no cursor_version, so a Claude Stop takes
# the line below this block exactly as before and never touches the network.
if [ "$EVENT" = Stop ] && [ -n "${CURSOR_VERSION:-}" ] && grep -Eq '"cursor_version"[[:space:]]*:[[:space:]]*"' "$T" 2>/dev/null; then
  cp "$T" "$T.req" 2>/dev/null; mv "$T" "$SPOOL/$TS-$$-$EVENT.json"
  # Nothing queued for this composer (almost every Stop): no request at all. The queue
  # folder sits beside the spool. If it is not there, or the id cannot be read here,
  # ask anyway rather than guess; the server reads the id the same way (conversation_id,
  # then session_id).
  QDIR="$(dirname "$SPOOL")/thread-turn-queue"
  CONV=$(grep -Eo '"conversation_id"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f-]{36}"' "$T.req" 2>/dev/null | grep -Eo '[0-9A-Fa-f-]{36}' | head -1 | tr 'A-F' 'a-f')
  [ -n "$CONV" ] || CONV=$(grep -Eo '"session_id"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f-]{36}"' "$T.req" 2>/dev/null | grep -Eo '[0-9A-Fa-f-]{36}' | head -1 | tr 'A-F' 'a-f')
  if [ -d "$QDIR" ] && [ -n "$CONV" ] && [ ! -f "$QDIR/cursor-$CONV.json" ]; then rm -f "$T.req"; exit 0; fi
  TOK=$(cat "$GH/hook-token" 2>/dev/null); PORT=$(cat "$GH/hook-port" 2>/dev/null || echo 3141)
  if [ -n "$TOK" ] && [ -f "$T.req" ]; then
    OUT=$(curl -s --connect-timeout 1 --max-time 3 -H "X-Cos-Hook-Token: $TOK" -H 'content-type: application/json' \
      --data-binary @"$T.req" "http://127.0.0.1:$PORT/hooks/cursor/stop-followup") || OUT=''
    case "$OUT" in '{"followup_message"'*) printf '%s' "$OUT" ;; esac
  fi
  rm -f "$T.req"; exit 0
fi
if [ "$EVENT" != PermissionRequest ]; then mv "$T" "$SPOOL/$TS-$$-$EVENT.json"; exit 0; fi   # rename = publish
# A permission request keeps its own copy: the server unlinks the published file within
# milliseconds of the rename, and the request body below must outlive that.
cp "$T" "$T.req" 2>/dev/null; mv "$T" "$SPOOL/$TS-$$-$EVENT.json"
cleanup() { rm -f "$T.req"; }
# Desk-active fast path decided HERE (about 30 ms): no HTTP at all when someone is at the
# keyboard. An unreadable idle time fails the same way: nothing is contacted, the native
# dialog shows.
IDLE_NS=$(ioreg -c IOHIDSystem 2>/dev/null | awk -F'= ' '/HIDIdleTime/{print $2; exit}')
DESK_S=$(cat "$GH/hook-desk-idle-s" 2>/dev/null || echo 90)
{ [ -n "$IDLE_NS" ] && [ "$(( ${IDLE_NS%.*} / 1000000000 ))" -ge "$DESK_S" ]; } || { cleanup; exit 0; }
TOK=$(cat "$GH/hook-token" 2>/dev/null); [ -n "$TOK" ] || { cleanup; exit 0; }   # no token, no request
PORT=$(cat "$GH/hook-port" 2>/dev/null || echo 3141)
OUT=$(curl -s --connect-timeout 2 --max-time 125 -H "X-Cos-Hook-Token: $TOK" -H 'content-type: application/json' \
  --data-binary @"$T.req" "http://127.0.0.1:$PORT/api/permission-requests/ask") || { cleanup; exit 0; }
cleanup
case "$OUT" in '{"hookSpecificOutput"'*) printf '%s' "$OUT" ;; esac
exit 0
